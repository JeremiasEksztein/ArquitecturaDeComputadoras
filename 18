    fdatos:
        
.text
    la a0, datos
    la a1, fdatos
    jal ra, empaquetar
    la a0, datos
    la a1, fdatos
    jal ra, imprimirVector
    fin:
    li a7, 10
    ecall
    
empaquetar:
    #while(t0 < t2)
    ##t3 = *t0
    ##*t0 = 0
    ##*t1 = t3 [Byte]
    ##t0++
    ##t1++
    
    beq a0, a1, fin
    mv t0, a0
    mv t1, t0
    mv t2, a1
    _CicloEmpaquetar:
        lw t3, 0(t0)
        sw zero, 0(t0)
        sb t3, 0(t1)
        addi t0, t0, 4
        addi t1, t1, 1
        blt t0, t2, _CicloEmpaquetar
        ret

imprimirVector:
    beq a0, a1, fin
    mv t0, a0
    mv t1, a1
    li a7, 99
    li t4, 99
    _CicloImprimir:
        lw t2, 0(t0)
        j _printNum
        _L0:
        addi t0, t0, 4
        blt t0, t1, _CicloImprimir
        ret
        
    _printNum:
        beq a7, t4, _primerNum
        li a7, 11
        li a0, 44
        ecall
        _primerNum:
        li a7, 1
        mv a0, t2
        ecall
        j _L0
        
