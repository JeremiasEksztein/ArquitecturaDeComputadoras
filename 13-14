.data
    info: .word 0x4f525041, 0x4f444142
    fininfo:
        
    linea1: .string "clima"
    linea2: .string "neuquen"
    linea3: .string "tramo"
        
.text
    la a0, linea1
    jal ra, esPalindromo
    la a0, linea2
    jal ra, esPalindromo
    la a0, linea3
    jal ra, esPalindromo
    fin:
    li a7, 10
    ecall
    
    
imprimirVector:
    beq a0, a1, fin
    mv t0, a0
    mv t1, a1
    li a7, 11
    imprimirVector_Ciclo:
        lbu a0, 0(t0)
        ecall
        addi t0, t0, 1
        blt t0, t1, imprimirVector_Ciclo
        ret
        
strlen:
    mv t0, a0
    li a1, 0
    lbu t1, 0(t0)
    beq t1, zero, _strlenFin
    _Ciclo:
        addi t0, t0, 1
        addi a1, a1, 1
        lbu t1, 0(t0)
        bne t1, zero, _Ciclo
        _strlenFin:
        ret

esPalindromo:
    sw ra, 0(sp)
    addi sp, sp, -4
    jal ra, strlen
    addi sp, sp, 4
    lw ra, 0(sp)
    mv t0, a0
    mv t1, a0
    mv t2, a1
    addi t2, t2, -1
    add t1, t1, t2
    lbu t2, 0(t0)
    lbu t3, 0(t1)
    bne t2, t3, _esPalindromoFallo
    _CicloEsPalindromo:
        addi t0, t0, 1
        addi t1, t1, -1
        beq t0, t1, _esPalindromoExito
        lbu t2, 0(t0)
        lbu t3, 0(t1)
        beq t2, t3, _CicloEsPalindromo
        
        _esPalindromoFallo:
        li a7, 1
        li a0, 1
        ecall
        ret
        
        _esPalindromoExito:
        li a0, 0
        ecall
        ret
