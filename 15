    fininfo:
    palabras_por_linea: .word 2
    
.text
    la a0, info
    la a1, fininfo
    la a2, palabras_por_linea
    lw a2, 0(a2)
    jal ra, imprimirMatriz
    fin:
    li a7, 10
    ecall
    
imprimirMatriz:
    beq a0, a1, fin
    blt a2, zero, fin
    mv t0, a0
    mv t1, a1
    mv t2, a2
    _CicloI:
        li a7, 35
        li t3, 0
        _CicloJ:
            lw a0, 0(t0)
            ecall
            addi t3, t3, 1
            addi t0, t0, 4
            blt t3, t2, _CicloJ
        li a7, 11
        li a0, 10
        ecall
        blt t0, t1, _CicloI
        ret    
