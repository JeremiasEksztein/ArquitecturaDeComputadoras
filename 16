.data
    numeros: .word 4, 7, 23, 14, 24, 35, 12
    finnumeros: 
    
.text
    la a0, numeros
    la a1, finnumeros
    jal ra, pares
    fin:
    li a7, 10
    ecall
    
pares:
    beq a0, a1, fin
    mv t0, a0
    mv t1, a1
    li a7, 99 #Valor sentinela
    _Ciclo:
        lw t2, 0(t0)
        andi t3, t2, 0x01
        beq t3, zero, _printPar
        _L0:
        addi t0, t0, 4
        blt t0, t1, _Ciclo
        li a7, 11
        li a0, 10
        ecall
        ret
        
    _printPar:
        li t4, 99
        beq a7, t4, _printPrimerPar
        li a7, 11
        li a0, 45
        ecall
        _printPrimerPar:
        li a7, 1
        mv a0, t2
        ecall
        j _L0
        
