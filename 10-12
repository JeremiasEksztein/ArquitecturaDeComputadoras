.data
    vector: .byte -1, -1, -2, 3, -5, 8, 12, -21, 34
    finvector:
        
.text
    la a3, vector
    la a4, finvector
    jal ra, puntoA
    jal ra, puntoB
    jal ra, puntoC
    jal ra, puntoA
    jal ra, puntoB
    fin:
    li a7, 10
    ecall
    
    
#Imprime un vector con formateado lindo
puntoA:
    beq a3, a4, fin
    mv t0, a3
    mv t1, a4
    lb t2, 0(t0)
    blt t2, zero, puntoA_PrintNeg
    j puntoA_PrintPos
    puntoA_Ciclo:
        li a7, 11
        li a0, 32
        ecall
        li a0, 124
        ecall
        li a0, 32
        ecall
        lb t2, 0(t0)
        blt t2, zero, puntoA_PrintNeg
        j puntoA_PrintPos
        
        
        puntoA_L0:
        addi t0, t0, 1
        blt t0, t1, puntoA_Ciclo
        li a7, 11
        li a0, 10
        ecall
        li a0, 13
        ecall
        ret
          
    puntoA_PrintNeg:
        li a7, 11
        li a0, 91
        ecall
        li a7, 1
        mv a0, t2
        ecall
        li a7, 11
        li a0, 93
        ecall
        j puntoA_L0
        
    puntoA_PrintPos:
        li a7, 1
        mv a0, t2
        ecall
        j puntoA_L0
        
puntoB:
    beq a3, a4, fin
    mv t0, a3
    mv t1, a4
    li a7, 11
    li a0, 49
    puntoB_Ciclo:
        lb t2, 0(t0)
        andi t2, t2, 0x01
        bne t2, zero, puntoB_PrintImpar
        addi t0, t0, 1
        blt t0, t1, puntoB_Ciclo
        ecall
        li a0, 10
        ecall
        li a0, 13
        ecall
        ret
        
    puntoB_PrintImpar:
        li a0, 48
        ecall
        li a0, 10
        ecall
        li a0, 13
        ecall
        ret        

puntoC:
    beq a3, a4, fin
    mv t0, a3
    mv t1, a4
    puntoC_Ciclo:
        lb t2, 0(t0)
        mv t3, t2
        andi t2, t2, 0x01
        bne t2, zero, puntoC_MultiplicarImpar
        puntoC_L0:
        addi t0, t0, 1
        blt t0, t1, puntoC_Ciclo
        ret
        
    puntoC_MultiplicarImpar:
        slli t3, t3, 1
        sb t3, 0(t0)
        j puntoC_L0
        
